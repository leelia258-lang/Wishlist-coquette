    sel.innerHTML = `<option value="all">${t('filter_all_categories')}</option>`;
    categories.forEach(cat => sel.innerHTML += `<option value="${cat.id}">${cat.name}</option>`);
}
function populateStoreFilter() {
    const sel = document.getElementById('storeFilter'); if (!sel) return;
    const names = new Set(); wishlist.forEach(item => { if (item.storeName) names.add(item.storeName); });
    sel.innerHTML = `<option value="all">${t('filter_all_stores')}</option>`;
    names.forEach(name => sel.innerHTML += `<option value="${name}">${name}</option>`);
}

